# Copy to .env (and add .env to .gitignore - never commit real credentials)

# --- Provider selection ---
# dry_run = no cloud account needed, uploads to ./cloud_mock_bucket/ on disk (default)
# gcs     = real Google Cloud Storage
# s3      = real AWS S3
CLOUD_PROVIDER=dry_run
CLOUD_BUCKET_NAME=enterprise-ecommerce-supply-chain-data

# --- Google Cloud Storage (only used when CLOUD_PROVIDER=gcs) ---
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCS_LOCATION=US

# --- AWS S3 (only used when CLOUD_PROVIDER=s3) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# --- Phase 6: Data Warehouse ---
# sqlite (default) needs nothing below - it's a local file at data/warehouse/warehouse.db
WAREHOUSE_ENGINE=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ecommerce_supply_chain
